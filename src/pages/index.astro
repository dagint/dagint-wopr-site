---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import StatusStrip from '@/components/StatusStrip.astro';
import ModuleCard from '@/components/ModuleCard.astro';
---

<Layout title="DaGint Computer Support">
  <Hero />
  <StatusStrip />

  <section class="page-section">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <ModuleCard n={1} title="Support & repair" text="PC and Mac repair, remote support, data recovery, and troubleshooting when you need it." href="/services" link="Services →" img="/img/services-support.webp" />
      <ModuleCard n={2} title="Infrastructure & security" text="Networking, security, updates, and authentication so your systems stay reliable and secure." href="/services" link="Learn more →" img="/img/services-security.webp" />
      <ModuleCard n={3} title="Managed & cloud" text="MSP-style monitoring, Microsoft 365, Azure, and lifecycle support so you can focus on your work." href="/services" link="Learn more →" img="/img/services-cloud.webp" />
    </div>
  </section>

  <section class="page-section border-t border-gray-200/80">
    <h2 class="text-xl font-mono font-semibold text-[var(--wopr-primary)] mb-4">Who we help</h2>
    <p class="text-gray-600 max-w-2xl">
      Home users, small offices, and growing teams. We tailor support to your size—from one-off fixes to ongoing managed services. No lock-in.
    </p>
    <a href="/contact" class="inline-flex items-center mt-6 px-5 py-2.5 rounded-lg text-sm font-medium text-white bg-[var(--wopr-primary)] hover:bg-[var(--wopr-secondary)] transition-colors">
      Email a request
    </a>
  </section>

  <section class="page-section border-t border-gray-200/80">
    <p class="text-gray-600">
      Questions? <a href="/contact" class="text-[var(--wopr-secondary)] font-medium hover:text-[var(--wopr-primary)] hover:underline">Get in touch</a>.
    </p>
  </section>
</Layout>
