---
// Hidden key sequence (up up down down left right left right b a) that flashes every lamp
// panel. Bundled script (CSP: script-src 'self'). The terminal look itself is now the default
// theme (html.terminal-mode in Layout), so there is no toggle.
---
<script>
  const root = document.documentElement;
  const seq = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
  let pos = 0;
  window.addEventListener('keydown', (e) => {
    const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    pos = key === seq[pos] ? pos + 1 : (key === seq[0] ? 1 : 0);
    if (pos === seq.length) {
      pos = 0;
      root.classList.add('lamps-flash');
      window.setTimeout(() => root.classList.remove('lamps-flash'), 1200);
    }
  });
</script>
