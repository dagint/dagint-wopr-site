---
// WOPR-inspired hero: cool blue palette, typing effect, glowing edges
---

<section class="relative min-h-[70vh] flex items-center justify-center overflow-hidden">
  <!-- Background: original indicator-lamp panel in blue shades (see .lamp-panel in global.css) -->
  <div class="absolute inset-0 lamp-panel" aria-hidden="true"></div>
  <!-- Darken the centre so the heading and buttons stay readable over the lamps -->
  <div class="absolute inset-0" style="background: radial-gradient(ellipse at center, rgba(8,24,46,.92) 0%, rgba(8,24,46,.75) 45%, rgba(8,24,46,.25) 100%);" aria-hidden="true"></div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="font-mono text-2xl sm:text-4xl md:text-5xl break-words font-bold text-white drop-shadow-lg">
      <span class="inline-block text-accent typing-caret" style="animation: typing-caret 1s step-end infinite;">SHALL WE PLAY A GAME?</span>
    </h1>
    <p class="mt-4 font-sans text-lg sm:text-xl text-gray-200 max-w-2xl mx-auto">
      …with your tech problems? <span class="text-accent font-semibold">DaGint</span> has you covered.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href="/services"
        class="inline-flex items-center px-6 py-3 rounded-lg font-mono font-semibold text-primary bg-accent hover:bg-60A5FA glow-border hover:glow-border-strong transition-all duration-300"
      >
        Our Services
      </a>
      <a
        href="/contact"
        class="inline-flex items-center px-6 py-3 rounded-lg font-mono font-semibold text-accent border-2 border-accent hover:bg-accent/10 transition-colors"
      >
        Get in Touch
      </a>
    </div>
  </div>

  <!-- Glowing bottom edge -->
  <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-accent to-transparent opacity-60" aria-hidden="true" />
</section>
